{
  "manifest_version": 3,
  "name": "Workspaces",
  "version": "4.3.1",
  "key": "",
  "description": "A compact Safari-style workspace switcher for Chrome.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Workspaces",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/workspaces-16.png",
      "32": "icons/workspaces-32.png",
      "48": "icons/workspaces-48.png",
      "128": "icons/workspaces-128.png"
    }
  },
  "icons": {
    "16": "icons/workspaces-16.png",
    "32": "icons/workspaces-32.png",
    "48": "icons/workspaces-48.png",
    "128": "icons/workspaces-128.png"
  },
  "commands": {
    "open-workspaces": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Option+W"
      },
      "description": "Open the Workspaces menu"
    }
  }
}
